// ─── Attendance & Payroll Enums ──────────────────────────────────────────────
enum PayrollStatus {
    PENDING
    PROCESSED
    PAID
    CANCELLED
}

enum PayrollPeriodType {
    MONTHLY
    BI_WEEKLY
    WEEKLY
    CUSTOM
}

enum DeductionType {
    LATE_ARRIVAL
    EARLY_DEPARTURE
    ABSENT
    UNAUTHORIZED_LEAVE
    OTHER
}

// --------------------------------------
// 2. Core Models
// --------------------------------------

model WorkingDay {
    id        String  @id @default(cuid())
    day       String
    openTime  String
    closeTime String
    isClosed  Boolean @default(false)

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])
}

model Leave {
    id         String    @id @default(cuid())
    startDate  DateTime?
    endDate    DateTime?
    type       String
    status     String    @default("PENDING")
    reason     String?
    approvedBy String?
    updatedAt  DateTime  @default(now())
    createdAt  DateTime  @default(now())

    userId   String
    user     User    @relation(fields: [userId], references: [id])
    agencyId String?
    agency   Agency? @relation(fields: [agencyId], references: [id])
}

model Address {
    id         String  @id @default(cuid())
    line1      String?
    line2      String?
    city       String?
    state      String?
    postalCode String?
    country    String?

    agency   Agency? @relation(fields: [agencyId], references: [id])
    agencyId String? @unique

    client   Client? @relation(fields: [clientId], references: [id])
    clientId String? @unique

    vendor   Vendor? @relation(fields: [vendorId], references: [id])
    vendorId String? @unique
}

model DiscoveryPersona {
    id             String  @id @default(cuid())
    name           String
    demographics   String?
    psychographics String?
    buyingBehavior String?
    goals          String?
    frustrations   String?

    opportunityId String
    opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model DiscoveryCompetitor {
    id          String  @id @default(cuid())
    name        String
    strengths   String?
    weaknesses  String?
    pricingNote String?
    marketShare String?

    opportunityId String
    opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

model DiscoveryProduct {
    id         String  @id @default(cuid())
    name       String
    sku        String?
    price      Float?
    usp        String?
    painPoints String?

    opportunityId String
    opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
}

// --------------------------------------
// 3. Identity & SaaS Multi-Tenancy
// --------------------------------------

model Agency {
    id              String   @id @default(cuid())
    agencyNo        String?
    agencyName      String
    operatorName    String?
    email           String?  @unique
    phoneNumber     String?
    field           String?
    website         String?
    logoUrl         String?
    timezone        String   @default("Africa/Cairo")
    defaultCurrency String   @default("EGP")
    billingAddress  String?
    address         String?
    addressDetails  Address?

    stripeCustomerId String?
    hasPaymentMethod Boolean @default(false)

    latitude     Float?
    longitude    Float?
    radius       Int          @default(100)
    workingHours WorkingDay[]

    subscription       Subscription?
    agencyInvoices     AgencyInvoice[]
    users              User[]
    departments        Department[]
    clients            Client[]
    clientContacts     ClientContact[]
    projects           Project[]
    campaigns          Campaign[]
    contracts          Contract[]
    taskCategories     TaskCategory[]
    tasks              Task[]
    plannedExpenses    TaskPlannedExpense[]
    taskExpenses       TaskExpense[]
    assets             Asset[]
    expenses           Expense[]
    payments           Payment[]
    paymentAllocations PaymentAllocation[]
    clientInvoices     ClientInvoice[]
    clientStatements   ClientStatement[]
    reportingPeriods   ReportingPeriod[]
    vendors            Vendor[]
    payouts            Payout[]
    attendanceLogs     AttendanceLog[]
    comments           Comment[]
    notifications      Notification[]
    todos              Todo[]
    attachments        Attachment[]
    auditLogs          AuditLog[]
    invitations        Invitation[]
    apiKeys            ApiKey[]

    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    deletedAt     DateTime?
    webhooks      Webhook[]
    clientBudgets ClientBudget[]

    exchangeRates             ExchangeRate[]
    creditNotes               CreditNote[]
    recurringInvoiceSchedules RecurringInvoiceSchedule[]
    holidays                  Holiday[]
    performanceReviews        PerformanceReview[]
    tags                      Tag[]
    announcements             Announcement[]
    emailLogs                 EmailLog[]
    clientFeedback            ClientFeedback[]
    approvalRequests          ApprovalRequest[]
    coupons                   Coupon[]
    leads                     Lead[]
    leadInteractions          LeadInteraction[]
    opportunities             Opportunity[]
    proposals                 Proposal[]

    milestones               Milestone[]
    projectTemplates         ProjectTemplate[]
    quotations               Quotation[]
    purchaseOrders           PurchaseOrder[]
    vendorPerformanceReviews VendorPerformanceReview[]
    concepts                 Concept[]
    creativeAssets           CreativeAsset[]
    creativeAssetVersions    CreativeAssetVersion[]
    digitalAdCampaigns       DigitalAdCampaign[]
    adMetricSnapshots        AdMetricSnapshot[]
    knowledgeArticles        KnowledgeArticle[]
    reports                  Report[]
    resourceAllocations      ResourceAllocation[]
    leaves                   Leave[]
    vendorCategories         VendorCategory[]
    plannedPurchaseOrders    PlannedPurchaseOrder[]
    commentMentions          CommentMention[]

    // ─── Payroll Models ──────────────────────────────────────────────────────
    payrollRecords     PayrollRecord[]
    payrollSettings    PayrollSetting?
    payrollPeriods     PayrollPeriod[]
    deductionRules     DeductionRule[]
    employeeDeductions EmployeeDeduction[]
    payslips           Payslip[]

    @@index([agencyName])
}

model Subscription {
    id       String             @id @default(cuid())
    agencyId String             @unique
    agency   Agency             @relation(fields: [agencyId], references: [id])
    plan     SubscriptionPlan   @default(FREE)
    status   SubscriptionStatus @default(TRIALING)

    stripeSubscriptionId String?
    stripePriceId        String?
    currentPeriodStart   DateTime?
    currentPeriodEnd     DateTime?
    cancelAtPeriodEnd    Boolean   @default(false)

    couponId String?
    coupon   Coupon? @relation(fields: [couponId], references: [id])

    maxUsers          Int     @default(5)
    maxProjects       Int     @default(50)
    hasAssetAccess    Boolean @default(false)
    geoFencingEnabled Boolean @default(false)
    advancedReporting Boolean @default(false)
    hasGeoTracking    Boolean @default(false)
    hasNotifications  Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model AgencyInvoice {
    id              String              @id @default(cuid())
    agencyId        String
    agency          Agency              @relation(fields: [agencyId], references: [id])
    type            AgencyInvoiceType   @default(SUBSCRIPTION)
    amount          Float
    currency        String              @default("EGP")
    status          AgencyInvoiceStatus @default(PENDING)
    stripeInvoiceId String?             @unique
    pdfUrl          String?
    plan            SubscriptionPlan
    periodStart     DateTime
    periodEnd       DateTime
    createdAt       DateTime            @default(now())

    @@index([agencyId, createdAt])
}

model Coupon {
    id             String             @id @default(cuid())
    code           String             @unique
    description    String?
    discountType   CouponDiscountType @default(PERCENTAGE)
    discountValue  Float
    appliesToPlan  SubscriptionPlan?
    maxRedemptions Int?
    timesRedeemed  Int                @default(0)
    validFrom      DateTime           @default(now())
    validUntil     DateTime?
    isActive       Boolean            @default(true)

    agencyId      String?
    agency        Agency?        @relation(fields: [agencyId], references: [id])
    subscriptions Subscription[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive, validUntil])
}

model Invitation {
    id         String    @id @default(cuid())
    email      String
    role       UserRole  @default(CREATIVE)
    tokenHash  String    @unique
    expiresAt  DateTime
    acceptedAt DateTime?
    agencyId   String
    sentById   String?
    sentBy     User?     @relation("InvitationsSent", fields: [sentById], references: [id])
    agency     Agency    @relation(fields: [agencyId], references: [id])
    createdAt  DateTime  @default(now())
    user       User?     @relation("InvitationsAccepted", fields: [userId], references: [id])
    userId     String?

    @@unique([agencyId, email])
}

model ApiKey {
    id      String @id @default(cuid())
    name    String
    keyHash String @unique

    scopes    String[] @default(["read:tasks"])
    rateLimit Int      @default(100)

    lastUsedAt    DateTime?
    expiresAt     DateTime?
    revokedAt     DateTime?
    revokedReason String?

    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
    createdAt DateTime @default(now())

    @@index([agencyId])
}

model RefreshToken {
    id        String    @id @default(cuid())
    tokenHash String    @unique
    userId    String
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    isRevoked Boolean   @default(false)
    revokedAt DateTime?
    ipAddress String?
    userAgent String?
    createdAt DateTime  @default(now())
    expiresAt DateTime

    @@index([userId])
}

model PasswordResetToken {
    id        String    @id @default(cuid())
    tokenHash String    @unique
    userId    String
    user      User      @relation(fields: [userId], references: [id])
    expiresAt DateTime
    usedAt    DateTime?
    createdAt DateTime  @default(now())

    @@index([userId])
}

// --------------------------------------
// 4. Users & HR
// --------------------------------------

model Department {
    id             String         @id @default(cuid())
    name           String
    agencyId       String
    agency         Agency         @relation(fields: [agencyId], references: [id])
    users          User[]
    createdAt      DateTime       @default(now())
    updatedAt      DateTime       @updatedAt
    taskCategories TaskCategory[]

    @@unique([agencyId, name])
}

model User {
    id             String    @id @default(cuid())
    userNo         String?
    name           String
    email          String    @unique
    password       String?
    avatarUrl      String?
    phoneNumber    String?
    userType       UserType  @default(FULL_TIME)
    role           UserRole  @default(CREATIVE)
    baseSalary     Float?    @default(0.0)
    walletBalance  Float     @default(0.0)
    verifiedSkills String[]
    efficiencyRate Float?    @default(1.0)
    leaves         Leave[]
    isActive       Boolean   @default(true)
    lastLoginAt    DateTime?

    twoFactorEnabled Boolean @default(false)
    twoFactorSecret  String?

    clientId String?
    client   Client? @relation("ClientPortalUsers", fields: [clientId], references: [id])

    agencyId     String
    agency       Agency      @relation(fields: [agencyId], references: [id])
    departmentId String?
    department   Department? @relation(fields: [departmentId], references: [id])

    tasks Task[] @relation("TaskAssignees")

    attendanceLogs  AttendanceLog[]
    comments        Comment[]
    financialLedger FinancialTransaction[]
    payouts         Payout[]
    expenses        Expense[]
    notifications   Notification[]
    taskSessions    TaskSession[]
    createdTodos    Todo[]                 @relation("TodoCreator")
    attachments     Attachment[]
    auditLogs       AuditLog[]

    createdAt           DateTime     @default(now())
    updatedAt           DateTime     @updatedAt
    deletedAt           DateTime?
    invitationsSent     Invitation[] @relation("InvitationsSent")
    invitationsAccepted Invitation[] @relation("InvitationsAccepted")

    refreshTokens         RefreshToken[]
    passwordResetTokens   PasswordResetToken[]
    reviewsReceived       PerformanceReview[]    @relation("ReviewedUser")
    reviewsGiven          PerformanceReview[]    @relation("ReviewerUser")
    announcementsAuthored Announcement[]
    approvalRequestsMade  ApprovalRequest[]      @relation("ApprovalRequester")
    approvalDecisionsMade ApprovalRequest[]      @relation("ApprovalDecider")
    leads                 Lead[]                 @relation("LeadOwner")
    leadInteractions      LeadInteraction[]      @relation("InteractionCreator")
    milestonesOwned       Milestone[]            @relation("MilestoneOwner")
    creativeAssetReviews  CreativeAssetVersion[] @relation("CreativeAssetReviewer")
    resourceAllocations   ResourceAllocation[]

    assignedOpportunities Opportunity[]    @relation("UserOpportunities")
    proposals             Proposal[]       @relation("ProposalUser")
    contracts             Contract[]       @relation("ContractUser")
    commentMentions       CommentMention[]

    // ─── Payroll Relations ──────────────────────────────────────────────────
    payrollRecords     PayrollRecord[]
    employeeDeductions EmployeeDeduction[]
    payslips           Payslip[]

    @@index([agencyId, role])
    @@index([agencyId, isActive])
    @@index([clientId])
}

model FinancialTransaction {
    id          String            @id @default(cuid())
    type        TransactionType
    status      TransactionStatus @default(PENDING)
    amount      Float
    currency    String            @default("EGP")
    description String?

    userId String
    user   User    @relation(fields: [userId], references: [id])
    taskId String?
    task   Task?   @relation(fields: [taskId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, status])
    @@index([taskId])
}

model AttendanceLog {
    id           String              @id @default(cuid())
    date         DateTime
    checkInTime  DateTime
    checkOutTime DateTime?
    isLate       Boolean             @default(false)
    isEarlyOut   Boolean             @default(false)
    totalHours   Float?
    status       AttendanceLogStatus @default(PRESENT)
    type         AttendanceLogType   @default(OFFICE)

    // Location tracking fields
    checkInLatitude   Float?
    checkInLongitude  Float?
    checkOutLatitude  Float?
    checkOutLongitude Float?

    userId   String
    user     User    @relation(fields: [userId], references: [id])
    agencyId String
    agency   Agency  @relation(fields: [agencyId], references: [id])
    taskId   String?
    task     Task?   @relation(fields: [taskId], references: [id])

    taskSessions       TaskSession[]
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt
    employeeDeductions EmployeeDeduction[]

    @@unique([userId, date])
    @@index([agencyId, date])
}

model TaskSession {
    id            String          @id @default(cuid())
    startTime     DateTime
    endTime       DateTime?
    totalDuration Float?
    sessionType   TaskSessionType @default(STANDARD)

    taskId          String
    task            Task           @relation(fields: [taskId], references: [id])
    userId          String
    user            User           @relation(fields: [userId], references: [id])
    attendanceLogId String?
    attendanceLog   AttendanceLog? @relation(fields: [attendanceLogId], references: [id])

    isBillable Boolean @default(true)
    hourlyRate Float?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([taskId, userId])
}

model Payout {
    id          String   @id @default(cuid())
    payoutNo    String?
    amount      Float
    currency    String   @default("EGP")
    category    String
    status      String   @default("PAID")
    date        DateTime @default(now())
    description String?

    userId   String
    user     User   @relation(fields: [userId], references: [id])
    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())

    @@index([agencyId, date])
    @@index([userId])
}

model Holiday {
    id                String   @id @default(cuid())
    name              String
    date              DateTime
    isRecurringYearly Boolean  @default(false)
    isPaid            Boolean  @default(true)

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())

    @@unique([agencyId, name, date])
    @@index([agencyId, date])
}

model PerformanceReview {
    id           String                  @id @default(cuid())
    periodStart  DateTime
    periodEnd    DateTime
    overallScore Float?
    strengths    String?
    improvements String?
    goals        String?
    status       PerformanceReviewStatus @default(DRAFT)

    userId     String
    user       User    @relation("ReviewedUser", fields: [userId], references: [id])
    reviewerId String?
    reviewer   User?   @relation("ReviewerUser", fields: [reviewerId], references: [id])
    agencyId   String
    agency     Agency  @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, periodStart])
    @@index([agencyId])
}

// ─── Payroll Models ──────────────────────────────────────────────────────────

model PayrollSetting {
    id       String @id @default(cuid())
    agencyId String @unique
    agency   Agency @relation(fields: [agencyId], references: [id])

    // Default settings
    payPeriodType               PayrollPeriodType @default(MONTHLY)
    payDay                      Int               @default(25) // Day of month
    currency                    String            @default("EGP")
    overtimeRateMultiplier      Float             @default(1.5)
    lateArrivalDeductionRate    Float             @default(0.0) // Per minute
    earlyDepartureDeductionRate Float             @default(0.0) // Per minute
    absentDayDeductionRate      Float             @default(1.0) // Full day

    // Tax & compliance
    taxRate             Float? @default(0.0)
    socialSecurityRate  Float? @default(0.0)
    healthInsuranceRate Float? @default(0.0)

    // Auto-checkout settings
    autoCheckoutEnabled Boolean @default(true)
    autoCheckoutHours   Float   @default(12.0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model PayrollPeriod {
    id       String @id @default(cuid())
    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    name        String
    periodType  PayrollPeriodType @default(MONTHLY)
    periodStart DateTime
    periodEnd   DateTime
    paymentDate DateTime?
    status      PayrollStatus     @default(PENDING)

    // Totals
    totalRegularHours  Float @default(0.0)
    totalOvertimeHours Float @default(0.0)
    totalGrossPay      Float @default(0.0)
    totalDeductions    Float @default(0.0)
    totalNetPay        Float @default(0.0)

    processedAt DateTime?
    notes       String?

    payrollRecords PayrollRecord[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([agencyId, periodStart, periodEnd])
    @@index([agencyId, status])
}

model PayrollRecord {
    id         String  @id @default(cuid())
    employeeId String
    agencyId   String
    periodId   String?

    // Period info
    periodStart DateTime
    periodEnd   DateTime
    payPeriod   String? // e.g., "January 2024"

    // Attendance metrics
    totalHours    Float @default(0.0)
    regularHours  Float @default(0.0)
    overtimeHours Float @default(0.0)

    // Attendance breakdown
    presentDays     Int @default(0)
    absentDays      Int @default(0)
    lateDays        Int @default(0)
    lateMinutes     Int @default(0)
    earlyDepartures Int @default(0)

    // Financial breakdown
    baseSalary    Float @default(0.0)
    regularPay    Float @default(0.0)
    overtimePay   Float @default(0.0)
    bonusPay      Float @default(0.0)
    commissionPay Float @default(0.0)

    // Deductions
    lateDeduction    Float @default(0.0)
    absenceDeduction Float @default(0.0)
    taxDeduction     Float @default(0.0)
    socialSecurity   Float @default(0.0)
    healthInsurance  Float @default(0.0)
    otherDeductions  Float @default(0.0)
    totalDeductions  Float @default(0.0)

    // Final amounts
    grossPay Float @default(0.0)
    netPay   Float @default(0.0)

    // Status
    status PayrollStatus @default(PENDING)

    // Metadata
    attendanceSummary Json? // Detailed attendance data
    notes             String?
    processedAt       DateTime?
    paidAt            DateTime?

    // Relations
    employee   User                @relation(fields: [employeeId], references: [id])
    agency     Agency              @relation(fields: [agencyId], references: [id])
    period     PayrollPeriod?      @relation(fields: [periodId], references: [id])
    deductions EmployeeDeduction[] @relation("PayrollDeductions")

    // One-to-One relation with Payslip - fields defined HERE
    payslipId String?  @unique
    payslip   Payslip? @relation(fields: [payslipId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([employeeId, periodStart])
    @@index([agencyId, status])
    @@index([periodId])
}

model DeductionRule {
    id       String @id @default(cuid())
    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    name        String
    description String?
    type        DeductionType
    isActive    Boolean       @default(true)

    // Deduction calculation
    calculationType String @default("FIXED") // FIXED, PERCENTAGE, PER_UNIT
    value           Float  @default(0.0)
    maxAmount       Float? // Maximum deduction cap
    minAmount       Float? // Minimum deduction

    // Applicability
    appliesToUserTypes UserType[]
    appliesToRoles     UserRole[]

    // Grace period (minutes)
    gracePeriod Int @default(15)

    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt
    employeeDeductions EmployeeDeduction[]

    @@index([agencyId, isActive])
}

model EmployeeDeduction {
    id         String @id @default(cuid())
    employeeId String
    agencyId   String

    // Reference
    ruleId          String?
    rule            DeductionRule? @relation(fields: [ruleId], references: [id])
    payrollRecordId String?
    payrollRecord   PayrollRecord? @relation("PayrollDeductions", fields: [payrollRecordId], references: [id])

    // Details
    type        DeductionType
    amount      Float
    currency    String        @default("EGP")
    description String?
    date        DateTime      @default(now())

    // Attendance reference (if applicable)
    attendanceLogId String?
    attendanceLog   AttendanceLog? @relation(fields: [attendanceLogId], references: [id])

    // Relations
    employee User   @relation(fields: [employeeId], references: [id])
    agency   Agency @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([employeeId, date])
    @@index([agencyId])
}

model Payslip {
    id         String @id @default(cuid())
    payslipNo  String @unique
    employeeId String
    agencyId   String

    // Period
    periodStart DateTime
    periodEnd   DateTime
    payPeriod   String

    // Earnings
    baseSalary    Float @default(0.0)
    regularPay    Float @default(0.0)
    overtimePay   Float @default(0.0)
    bonusPay      Float @default(0.0)
    commissionPay Float @default(0.0)
    otherEarnings Float @default(0.0)
    totalEarnings Float @default(0.0)

    // Deductions
    lateDeduction    Float @default(0.0)
    absenceDeduction Float @default(0.0)
    taxDeduction     Float @default(0.0)
    socialSecurity   Float @default(0.0)
    healthInsurance  Float @default(0.0)
    otherDeductions  Float @default(0.0)
    totalDeductions  Float @default(0.0)

    // Net pay
    netPay Float @default(0.0)

    // Status
    status PayrollStatus @default(PENDING)

    // File
    pdfUrl  String?
    fileUrl String?

    // Relations - Reverse side with NO fields/references arguments
    payrollRecordId String?        @unique
    payrollRecord   PayrollRecord? @relation

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    agency    Agency   @relation(fields: [agencyId], references: [id])
    user      User?    @relation(fields: [userId], references: [id])
    userId    String?

    @@index([employeeId, payPeriod])
    @@index([agencyId, periodStart])
}

// --------------------------------------
// 5. Clients, Projects, Campaigns & Contracts
// --------------------------------------

model Lead {
    id                 String     @id @default(cuid())
    leadNo             String?
    companyName        String
    contactName        String?
    contactEmail       String?
    contactPhone       String?
    industry           String?
    estimatedBudget    Float?
    currency           String     @default("EGP")
    expectedCloseDate  DateTime?
    source             LeadSource @default(OTHER)
    status             LeadStatus @default(NEW)
    disqualifiedReason String?
    convertedAt        DateTime?
    notes              String?

    agencyId String
    agency   Agency  @relation(fields: [agencyId], references: [id])
    ownerId  String?
    owner    User?   @relation("LeadOwner", fields: [ownerId], references: [id])

    interactions LeadInteraction[]
    opportunity  Opportunity?

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([agencyId, status])
    @@index([agencyId, leadNo])
}

model LeadInteraction {
    id         String          @id @default(cuid())
    type       InteractionType
    summary    String
    occurredAt DateTime        @default(now())

    leadId      String
    lead        Lead    @relation(fields: [leadId], references: [id])
    agencyId    String
    agency      Agency  @relation(fields: [agencyId], references: [id])
    createdById String?
    createdBy   User?   @relation("InteractionCreator", fields: [createdById], references: [id])

    createdAt DateTime @default(now())

    @@index([leadId, occurredAt])
}

model Opportunity {
    id       String           @id @default(cuid())
    name     String
    stage    OpportunityStage @default(DISCOVERY)
    budget   Float?
    currency String           @default("EGP")

    expectedCloseDate   DateTime?
    companyMission      String?
    brandValues         String?
    personas            DiscoveryPersona[]
    competitors         DiscoveryCompetitor[]
    products            DiscoveryProduct[]
    marketResearchNotes String?

    marketingStrategy     String?
    communicationStrategy String?
    mediaStrategy         String?
    creativeStrategy      String?
    launchStrategy        String?
    kpis                  String[]

    leadId String? @unique
    lead   Lead?   @relation(fields: [leadId], references: [id])

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    proposals Proposal[]

    userId String?
    user   User?   @relation("UserOpportunities", fields: [userId], references: [id])

    clientId String?
    client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, stage])
}

model Proposal {
    id              String         @id @default(cuid())
    proposalNo      String?        @unique
    status          ProposalStatus @default(DRAFT)
    totalAmount     Float          @default(0.0)
    currency        String         @default("EGP")
    validUntil      DateTime?
    scope           String?        @db.Text
    risks           String?        @db.Text
    assumptions     String?        @db.Text
    paymentSchedule String?        @db.Text

    opportunityId String
    opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
    agencyId      String
    agency        Agency      @relation(fields: [agencyId], references: [id])

    lineItems ProposalLineItem[]

    userId String?
    user   User?   @relation("ProposalUser", fields: [userId], references: [id])

    clientId String?
    client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

    contractId String?   @unique
    contract   Contract? @relation(fields: [contractId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, status])
    @@index([clientId])
}

model ProposalLineItem {
    id          String @id @default(cuid())
    description String
    quantity    Float  @default(1.0)
    unitPrice   Float  @default(0.0)
    total       Float  @default(0.0)

    proposalId String
    proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Client {
    id               String           @id @default(cuid())
    clientNo         String?
    clientName       String
    accountType      String?
    status           String           @default("ACTIVE")
    relationshipType RelationshipType @default(ONE_TIME)
    email            String?
    phoneNumber      String?
    website          String?
    billingAddress   Address?
    notes            String?

    creditLimit         Float?
    outstandingBalance  Float   @default(0.0)
    isOnCreditHold      Boolean @default(false)
    creditHoldReason    String?
    creditLimitAlertPct Float?  @default(90.0)

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    contacts           ClientContact[]
    contracts          Contract[]
    projects           Project[]
    campaigns          Campaign[]
    clientInvoices     ClientInvoice[]
    payments           Payment[]
    paymentAllocations PaymentAllocation[]
    statements         ClientStatement[]

    createdAt     DateTime       @default(now())
    updatedAt     DateTime       @updatedAt
    deletedAt     DateTime?
    clientBudgets ClientBudget[]

    portalUsers               User[]                     @relation("ClientPortalUsers")
    creditNotes               CreditNote[]
    recurringInvoiceSchedules RecurringInvoiceSchedule[]
    feedback                  ClientFeedback[]
    reports                   Report[]
    opportunities             Opportunity[]
    proposals                 Proposal[]

    @@index([agencyId, clientNo])
    @@index([agencyId, clientName])
    @@index([agencyId, isOnCreditHold])
}

model ClientBudget {
    id              String @id @default(cuid())
    totalAmount     Float
    spentAmount     Float  @default(0.0)
    remainingAmount Float

    currency    String   @default("USD")
    periodStart DateTime
    periodEnd   DateTime

    isActive Boolean @default(true)

    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([clientId, isActive])
}

model ReportingPeriod {
    id          String                @id @default(cuid())
    name        String
    periodStart DateTime
    periodEnd   DateTime
    status      ReportingPeriodStatus @default(OPEN)
    closedAt    DateTime?

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([agencyId, name])
    @@index([agencyId, periodStart, periodEnd])
}

model ClientContact {
    id          String   @id @default(cuid())
    name        String
    title       String?
    email       String?
    phoneNumber String?
    isPrimary   Boolean  @default(false)
    clientId    String
    client      Client   @relation(fields: [clientId], references: [id])
    agencyId    String
    agency      Agency   @relation(fields: [agencyId], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([clientId])
}

model Contract {
    id           String         @id @default(cuid())
    contractNo   String?
    name         String
    status       ContractStatus @default(ACTIVE)
    startDate    DateTime?
    endDate      DateTime?
    monthlyValue Float?
    currency     String         @default("EGP")
    termsUrl     String?

    userId String?
    user   User?   @relation("ContractUser", fields: [userId], references: [id])

    clientId        String
    client          Client                    @relation(fields: [clientId], references: [id])
    agencyId        String
    agency          Agency                    @relation(fields: [agencyId], references: [id])
    taskDefinitions RecurringTaskDefinition[]
    projects        Project[]
    tasks           Task[]

    recurringInvoiceSchedules RecurringInvoiceSchedule[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    proposal  Proposal?

    @@index([agencyId, contractNo])
    @@index([clientId, status])
}

model RecurringTaskDefinition {
    id             String        @id @default(cuid())
    contractId     String
    contract       Contract      @relation(fields: [contractId], references: [id])
    title          String
    description    String?
    frequency      TaskFrequency @default(MONTHLY)
    countPerPeriod Int
    categoryId     String?
    category       TaskCategory? @relation(fields: [categoryId], references: [id])
    plannedCost    Float         @default(0.0)
    plannedRevenue Float         @default(0.0)
    nextOccurrence DateTime      @default(now())
    timeZone       String        @default("UTC")
    isActive       Boolean       @default(true)
    createdAt      DateTime      @default(now())
    updatedAt      DateTime      @updatedAt
}

model Campaign {
    id         String         @id @default(cuid())
    campaignNo String?
    name       String
    status     CampaignStatus @default(PLANNED)
    objective  String?
    budget     Float          @default(0.0)
    currency   String         @default("EGP")
    startDate  DateTime
    endDate    DateTime?

    agencyId           String
    agency             Agency              @relation(fields: [agencyId], references: [id])
    clientId           String
    client             Client              @relation(fields: [clientId], references: [id])
    projects           Project[]
    digitalAdCampaigns DigitalAdCampaign[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, campaignNo])
    @@index([agencyId, status])
}

model Project {
    id             String        @id @default(cuid())
    projectNo      String?
    name           String
    projectName    String
    targetDeadline DateTime?
    status         ProjectStatus @default(ACTIVE)
    projectStory   String?
    cloudLink      String?
    totalValue     Float         @default(0.0)
    currency       String        @default("EGP")
    invoiceNo      String?
    invoiceStatus  InvoiceStatus @default(DRAFT)

    agencyId   String
    agency     Agency    @relation(fields: [agencyId], references: [id])
    clientId   String
    client     Client    @relation(fields: [clientId], references: [id])
    campaignId String?
    campaign   Campaign? @relation(fields: [campaignId], references: [id])
    contractId String?
    contract   Contract? @relation(fields: [contractId], references: [id])

    brief           CreativeBrief?
    milestones      Milestone[]
    tasks           Task[]
    taskExpenses    TaskExpense[]
    plannedExpenses TaskPlannedExpense[]
    payments        Payment[]
    clientInvoices  ClientInvoice[]
    attachments     Attachment[]

    tags     Tag[]            @relation("ProjectTags")
    feedback ClientFeedback[]

    quotations               Quotation[]
    purchaseOrders           PurchaseOrder[]
    vendorPerformanceReviews VendorPerformanceReview[]
    concepts                 Concept[]
    digitalAdCampaigns       DigitalAdCampaign[]
    knowledgeArticles        KnowledgeArticle[]
    reports                  Report[]
    resourceAllocations      ResourceAllocation[]

    createdAt             DateTime               @default(now())
    updatedAt             DateTime               @updatedAt
    deletedAt             DateTime?
    plannedPurchaseOrders PlannedPurchaseOrder[]
    comments              Comment[]

    @@index([agencyId, projectNo])
    @@index([agencyId, status])
    @@index([clientId])
}

model CreativeBrief {
    id           String      @id @default(cuid())
    title        String
    status       BriefStatus @default(DRAFT)
    budget       Float?
    objectives   String
    audience     String?
    keyMessage   String?
    deliverables String[]
    references   String[]
    projectId    String      @unique
    project      Project     @relation(fields: [projectId], references: [id])
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt
}

model Milestone {
    id            String                 @id @default(cuid())
    name          String
    description   String?
    order         Int                    @default(0)
    deadline      DateTime?
    budget        Float                  @default(0.0)
    currency      String                 @default("EGP")
    riskLevel     RiskLevel              @default(LOW)
    approvalStage MilestoneApprovalStage @default(NOT_SUBMITTED)
    status        MilestoneStatus        @default(PENDING)
    completedAt   DateTime?

    projectId String
    project   Project @relation(fields: [projectId], references: [id])
    agencyId  String
    agency    Agency  @relation(fields: [agencyId], references: [id])
    ownerId   String?
    owner     User?   @relation("MilestoneOwner", fields: [ownerId], references: [id])

    dependsOn  Milestone[] @relation("MilestoneDependencies")
    dependents Milestone[] @relation("MilestoneDependencies")

    tasks Task[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([projectId, order])
    @@index([agencyId, status])
}

model ProjectTemplate {
    id          String       @id @default(cuid())
    name        String
    description String?
    serviceType String?
    type        TemplateType @default(PROJECT)

    agencyId String
    agency   Agency                @relation(fields: [agencyId], references: [id])
    items    ProjectTemplateItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([agencyId, name])
}

model ProjectTemplateItem {
    id             String        @id @default(cuid())
    milestoneName  String
    taskTitle      String
    taskType       String
    description    String?
    estimatedHours Float         @default(0.0)
    order          Int           @default(0)
    categoryId     String?
    category       TaskCategory? @relation(fields: [categoryId], references: [id])

    templateId String
    template   ProjectTemplate @relation(fields: [templateId], references: [id])

    createdAt DateTime @default(now())

    @@index([templateId, order])
}

// --------------------------------------
// 6. Production, Tasks & Expenses
// --------------------------------------

model TaskCategory {
    id            String                    @id @default(cuid())
    name          String
    description   String?
    agencyId      String
    agency        Agency                    @relation(fields: [agencyId], references: [id])
    tasks         Task[]
    definitions   RecurringTaskDefinition[]
    templateItems ProjectTemplateItem[]
    departmentId  String?
    department    Department?               @relation(fields: [departmentId], references: [id])
    createdAt     DateTime                  @default(now())
    updatedAt     DateTime                  @updatedAt

    @@unique([agencyId, name])
}

model Task {
    id             String            @id @default(cuid())
    taskNo         String?
    taskType       String
    title          String?
    description    String?
    progress       Int               @default(0)
    status         TaskStatus        @default(PENDING)
    priority       TaskPriority      @default(MEDIUM)
    actualHours    Float             @default(0.0)
    estimatedHours Float             @default(0.0)
    paymentStatus  TaskPaymentStatus @default(UNPAID)
    isNotified     Boolean           @default(false)

    totalInvoice  Float @default(0.0)
    internalCost  Float @default(0.0)
    margin        Float @default(30.0)
    marginAmount  Float @default(0.0)
    taskNetProfit Float @default(0.0)
    realCost      Float @default(0.0)

    plannedExpenseTotal Float @default(0.0)
    plannedRevenue      Float @default(0.0)
    approvedBudget      Float @default(0.0)
    budgetVariance      Float @default(0.0)

    startDate   DateTime?
    endDate     DateTime?
    dueDate     DateTime?
    completedAt DateTime?

    locationName String?
    latitude     Float?
    longitude    Float?
    radius       Int       @default(200)
    arrivalAt    DateTime?
    departureAt  DateTime?

    isOutOfWorkingHours  Boolean             @default(false)
    compensationStrategy CompensationType    @default(NONE)
    deductionStrategy    AttendanceDeduction @default(NONE)

    dependsOn  Task[] @relation("TaskDependencies")
    dependents Task[] @relation("TaskDependencies")

    projectId   String
    project     Project       @relation(fields: [projectId], references: [id])
    agencyId    String
    agency      Agency        @relation(fields: [agencyId], references: [id])
    categoryId  String?
    category    TaskCategory? @relation(fields: [categoryId], references: [id])
    contractId  String?
    contract    Contract?     @relation(fields: [contractId], references: [id])
    milestoneId String?
    milestone   Milestone?    @relation(fields: [milestoneId], references: [id])

    assignees User[]  @relation("TaskAssignees")
    assets    Asset[] @relation("TaskAssets")

    plannedExpenses       TaskPlannedExpense[]
    taskExpenses          TaskExpense[]
    quotations            Quotation[]
    comments              Comment[]
    attendanceLogs        AttendanceLog[]
    todos                 Todo[]
    financialTransactions FinancialTransaction[]
    taskSessions          TaskSession[]
    attachments           Attachment[]
    invoiceItems          ClientInvoiceItem[]
    resourceAllocations   ResourceAllocation[]

    tags Tag[] @relation("TaskTags")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([agencyId, taskNo])
    @@index([agencyId, status])
    @@index([projectId, status])
    @@index([categoryId])
}

model TaskPlannedExpense {
    id            String               @id @default(cuid())
    itemName      String
    estimatedCost Float                @default(0.0)
    approvedCost  Float?
    category      TaskExpenseCategory  @default(EQUIPMENT)
    status        PlannedExpenseStatus @default(DRAFT)
    description   String?
    quantity      Float                @default(1.0)
    unitCost      Float                @default(0.0)
    currency      String               @default("EGP")

    isRecurring Boolean @default(false)
    taxRate     Float   @default(0.0)

    totalEstimated Float @default(0.0)

    taskId    String
    task      Task    @relation(fields: [taskId], references: [id])
    projectId String
    project   Project @relation(fields: [projectId], references: [id])
    vendorId  String?
    vendor    Vendor? @relation(fields: [vendorId], references: [id])
    agencyId  String
    agency    Agency  @relation(fields: [agencyId], references: [id])

    actualExpenses TaskExpense[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([taskId, status])
    @@index([agencyId, category])
}

model TaskExpense {
    id           String              @id @default(cuid())
    itemName     String
    cost         Float
    category     TaskExpenseCategory @default(EQUIPMENT)
    status       ActualExpenseStatus @default(PENDING)
    description  String?
    receiptUrl   String?
    incurredAt   DateTime?
    reimbursable Boolean             @default(false)

    taskId           String
    task             Task                @relation(fields: [taskId], references: [id])
    projectId        String
    project          Project             @relation(fields: [projectId], references: [id])
    plannedExpenseId String?
    plannedExpense   TaskPlannedExpense? @relation(fields: [plannedExpenseId], references: [id])
    vendorId         String?
    vendor           Vendor?             @relation(fields: [vendorId], references: [id])
    agencyId         String
    agency           Agency              @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([taskId, status])
    @@index([projectId])
    @@index([vendorId])
}

model CommentMention {
    id        String   @id @default(cuid())
    commentId String
    comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])
    createdAt DateTime @default(now())

    @@unique([commentId, userId])
    @@index([userId])
    @@index([agencyId])
}

model Comment {
    id              String           @id @default(cuid())
    text            String
    taskId          String?
    task            Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
    projectId       String?
    project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
    conceptId       String? // ✅ Add this
    concept         Concept?         @relation(fields: [conceptId], references: [id], onDelete: Cascade) // ✅ Add this
    authorId        String?
    author          User?            @relation(fields: [authorId], references: [id])
    agencyId        String
    agency          Agency           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
    createdAt       DateTime         @default(now())
    commentMentions CommentMention[]

    @@index([taskId])
    @@index([projectId])
    @@index([conceptId]) // ✅ Add this
}

model Todo {
    id          String       @id @default(cuid())
    text        String
    description String?
    completed   Boolean      @default(false)
    priority    TaskPriority @default(MEDIUM)
    order       Int          @default(0)
    dueDate     DateTime?

    taskId      String
    task        Task    @relation(fields: [taskId], references: [id])
    agencyId    String
    agency      Agency  @relation(fields: [agencyId], references: [id])
    createdById String?
    createdBy   User?   @relation("TodoCreator", fields: [createdById], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([taskId, completed])
}

model Tag {
    id    String @id @default(cuid())
    name  String
    color String @default("#6366F1")

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    tasks    Task[]    @relation("TaskTags")
    projects Project[] @relation("ProjectTags")

    createdAt DateTime @default(now())

    @@unique([agencyId, name])
}

model Concept {
    id          String        @id @default(cuid())
    name        String
    description String?       @db.Text
    status      ConceptStatus @default(DRAFT)

    projectId String
    project   Project @relation(fields: [projectId], references: [id])
    agencyId  String
    agency    Agency  @relation(fields: [agencyId], references: [id])

    assets CreativeAsset[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    comments  Comment[]

    @@unique([projectId, name]) // Prevent duplicate concept names within same project
    @@index([projectId, status])
}

model CreativeAsset {
    id   String            @id @default(cuid())
    name String
    type CreativeAssetType @default(OTHER)

    conceptId String
    concept   Concept @relation(fields: [conceptId], references: [id])
    agencyId  String
    agency    Agency  @relation(fields: [agencyId], references: [id])

    versions CreativeAssetVersion[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([conceptId])
}

model CreativeAssetVersion {
    id        String                     @id @default(cuid())
    versionNo Int                        @default(1)
    fileUrl   String?
    status    CreativeAssetVersionStatus @default(DRAFT)
    feedback  String?                    @db.Text // ✅ Make it Text for longer feedback

    creativeAssetId String
    creativeAsset   CreativeAsset @relation(fields: [creativeAssetId], references: [id])
    reviewedById    String?
    reviewedBy      User?         @relation("CreativeAssetReviewer", fields: [reviewedById], references: [id])
    agencyId        String
    agency          Agency        @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt // ✅ Add updatedAt for tracking review timestamps

    @@index([creativeAssetId, versionNo])
}

model DigitalAdCampaign {
    id              String                @id @default(cuid())
    name            String
    platform        AdPlatform            @default(FACEBOOK)
    status          DigitalCampaignStatus @default(DRAFT)
    budget          Float                 @default(0.0)
    currency        String                @default("EGP")
    landingPageUrl  String?
    utmSource       String?
    utmMedium       String?
    utmCampaign     String?
    pixelId         String?
    audienceSegment String?
    startDate       DateTime?
    endDate         DateTime?

    projectId  String
    project    Project   @relation(fields: [projectId], references: [id])
    campaignId String?
    campaign   Campaign? @relation(fields: [campaignId], references: [id])
    agencyId   String
    agency     Agency    @relation(fields: [agencyId], references: [id])

    metrics AdMetricSnapshot[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([projectId])
    @@index([agencyId, status])
}

model AdMetricSnapshot {
    id          String   @id @default(cuid())
    date        DateTime
    reach       Int      @default(0)
    impressions Int      @default(0)
    clicks      Int      @default(0)
    ctr         Float    @default(0.0)
    cpc         Float    @default(0.0)
    cpm         Float    @default(0.0)
    spend       Float    @default(0.0)
    conversions Int      @default(0)
    revenue     Float    @default(0.0)
    roas        Float    @default(0.0)
    leads       Int      @default(0)
    engagement  Int      @default(0)

    adCampaignId String
    adCampaign   DigitalAdCampaign @relation(fields: [adCampaignId], references: [id])
    agencyId     String
    agency       Agency            @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())

    @@unique([adCampaignId, date])
    @@index([agencyId, date])
}

model KnowledgeArticle {
    id      String               @id @default(cuid())
    title   String
    type    KnowledgeArticleType @default(OTHER)
    content String
    tags    String[]

    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])
    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, type])
}

model Report {
    id          String       @id @default(cuid())
    name        String
    type        ReportType   @default(PROJECT)
    format      ReportFormat @default(PDF)
    fileUrl     String?
    periodStart DateTime?
    periodEnd   DateTime?
    summary     String?

    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])
    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])
    clientId  String?
    client    Client?  @relation(fields: [clientId], references: [id])

    createdAt DateTime @default(now())

    @@index([agencyId, type])
    @@index([projectId])
    @@index([clientId])
}

model ResourceAllocation {
    id                String    @id @default(cuid())
    allocationPercent Float     @default(100.0)
    hourlyCost        Float?
    startDate         DateTime
    endDate           DateTime?

    userId    String
    user      User    @relation(fields: [userId], references: [id])
    projectId String
    project   Project @relation(fields: [projectId], references: [id])
    taskId    String?
    task      Task?   @relation(fields: [taskId], references: [id])
    agencyId  String
    agency    Agency  @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId, startDate])
    @@index([projectId])
}

// --------------------------------------
// 7. Invoicing, Payments, Vendors & Assets
// --------------------------------------

model ClientInvoice {
    id          String            @id @default(cuid())
    invoiceNo   String
    type        ClientInvoiceType @default(PROJECT_BASED)
    status      InvoiceStatus     @default(DRAFT)
    subtotal    Float             @default(0.0)
    taxAmount   Float             @default(0.0)
    discount    Float             @default(0.0)
    totalAmount Float             @default(0.0)
    amountPaid  Float             @default(0.0)
    balanceDue  Float             @default(0.0)
    currency    String            @default("EGP")
    issuedAt    DateTime?
    dueDate     DateTime?
    paidAt      DateTime?
    periodStart DateTime?
    periodEnd   DateTime?
    notes       String?

    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])
    clientId  String
    client    Client   @relation(fields: [clientId], references: [id])
    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])

    items          ClientInvoiceItem[]
    payments       Payment[]
    allocations    PaymentAllocation[]
    statementLines ClientStatementLine[]

    creditNotes CreditNote[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([agencyId, invoiceNo])
    @@index([clientId, status])
    @@index([agencyId, issuedAt])
    @@index([clientId, dueDate])
}

model ClientInvoiceItem {
    id             String  @id @default(cuid())
    description    String
    quantity       Float   @default(1.0)
    unitPrice      Float   @default(0.0)
    total          Float   @default(0.0)
    taxRate        Float   @default(0.0)
    discountAmount Float   @default(0.0)
    isBillable     Boolean @default(true)

    invoiceId String
    invoice   ClientInvoice @relation(fields: [invoiceId], references: [id])
    taskId    String?
    task      Task?         @relation(fields: [taskId], references: [id])

    createdAt DateTime @default(now())
}

model Payment {
    id              String        @id @default(cuid())
    paymentNo       String?
    amount          Float
    unappliedAmount Float         @default(0.0)
    currency        String        @default("EGP")
    method          PaymentMethod @default(CASH)
    status          PaymentStatus @default(COMPLETED)
    datePaid        DateTime
    description     String?
    referenceNo     String?

    agencyId       String
    agency         Agency                @relation(fields: [agencyId], references: [id])
    clientId       String
    client         Client                @relation(fields: [clientId], references: [id])
    projectId      String?
    project        Project?              @relation(fields: [projectId], references: [id])
    invoiceId      String?
    invoice        ClientInvoice?        @relation(fields: [invoiceId], references: [id])
    allocations    PaymentAllocation[]
    statementLines ClientStatementLine[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, paymentNo])
    @@index([clientId, datePaid])
    @@index([invoiceId])
    @@index([agencyId, status, datePaid])
}

model PaymentAllocation {
    id          String                  @id @default(cuid())
    amount      Float
    currency    String                  @default("EGP")
    status      PaymentAllocationStatus @default(APPLIED)
    allocatedAt DateTime                @default(now())
    notes       String?

    agencyId  String
    agency    Agency        @relation(fields: [agencyId], references: [id])
    clientId  String
    client    Client        @relation(fields: [clientId], references: [id])
    paymentId String
    payment   Payment       @relation(fields: [paymentId], references: [id])
    invoiceId String
    invoice   ClientInvoice @relation(fields: [invoiceId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([paymentId])
    @@index([invoiceId])
    @@index([clientId, allocatedAt])
}

model ClientStatement {
    id               String                @id @default(cuid())
    statementNo      String
    status           ClientStatementStatus @default(DRAFT)
    periodStart      DateTime
    periodEnd        DateTime
    openingBalance   Float                 @default(0.0)
    invoicedAmount   Float                 @default(0.0)
    paidAmount       Float                 @default(0.0)
    creditAmount     Float                 @default(0.0)
    adjustmentAmount Float                 @default(0.0)
    closingBalance   Float                 @default(0.0)
    currency         String                @default("EGP")
    issuedAt         DateTime?
    dueDate          DateTime?
    pdfUrl           String?
    notes            String?

    agencyId String
    agency   Agency                @relation(fields: [agencyId], references: [id])
    clientId String
    client   Client                @relation(fields: [clientId], references: [id])
    lines    ClientStatementLine[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([agencyId, statementNo])
    @@index([clientId, periodStart, periodEnd])
    @@index([agencyId, status])
}

model ClientStatementLine {
    id          String            @id @default(cuid())
    lineDate    DateTime
    type        StatementLineType
    description String
    debit       Float             @default(0.0)
    credit      Float             @default(0.0)
    balance     Float             @default(0.0)
    sortOrder   Int               @default(0)

    statementId String
    statement   ClientStatement @relation(fields: [statementId], references: [id])
    invoiceId   String?
    invoice     ClientInvoice?  @relation(fields: [invoiceId], references: [id])
    paymentId   String?
    payment     Payment?        @relation(fields: [paymentId], references: [id])

    createdAt DateTime @default(now())

    @@index([statementId, sortOrder])
    @@index([invoiceId])
    @@index([paymentId])
}

model CreditNote {
    id           String           @id @default(cuid())
    creditNoteNo String
    amount       Float
    currency     String           @default("EGP")
    reason       CreditNoteReason @default(OTHER)
    status       CreditNoteStatus @default(DRAFT)
    notes        String?

    agencyId  String
    agency    Agency         @relation(fields: [agencyId], references: [id])
    clientId  String
    client    Client         @relation(fields: [clientId], references: [id])
    invoiceId String?
    invoice   ClientInvoice? @relation(fields: [invoiceId], references: [id])

    issuedAt  DateTime?
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@unique([agencyId, creditNoteNo])
    @@index([clientId])
    @@index([invoiceId])
}

model RecurringInvoiceSchedule {
    id          String                    @id @default(cuid())
    name        String
    amount      Float
    currency    String                    @default("EGP")
    frequency   RecurringInvoiceFrequency @default(MONTHLY)
    dayOfMonth  Int?
    nextRunDate DateTime
    isActive    Boolean                   @default(true)

    agencyId   String
    agency     Agency    @relation(fields: [agencyId], references: [id])
    clientId   String
    client     Client    @relation(fields: [clientId], references: [id])
    contractId String?
    contract   Contract? @relation(fields: [contractId], references: [id])

    lastGeneratedInvoiceId String?
    lastRunAt              DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, nextRunDate])
    @@index([clientId])
}

model ExchangeRate {
    id            String   @id @default(cuid())
    baseCurrency  String
    quoteCurrency String
    rate          Float
    effectiveDate DateTime @default(now())
    source        String   @default("manual")

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())

    @@unique([agencyId, baseCurrency, quoteCurrency, effectiveDate])
    @@index([agencyId, effectiveDate])
}

model Vendor {
    id            String       @id @default(cuid())
    vendorNo      String?
    name          String
    email         String?
    phoneNumber   String?
    status        VendorStatus @default(ACTIVE)
    averageRating Float?       @default(0.0)
    reviewCount   Int          @default(0)

    categoryId String?
    category   VendorCategory? @relation("VendorCategoryRelation", fields: [categoryId], references: [id], onDelete: SetNull)

    address                     Address?
    taxNumber                   String?
    notes                       String?
    paymentTerms                String                       @default("COD")
    agencyId                    String
    agency                      Agency                       @relation(fields: [agencyId], references: [id])
    plannedExpenses             TaskPlannedExpense[]
    expenses                    TaskExpense[]
    quotations                  Quotation[]
    purchaseOrders              PurchaseOrder[]
    performanceReviews          VendorPerformanceReview[]
    createdAt                   DateTime                     @default(now())
    updatedAt                   DateTime                     @updatedAt
    quotationVendors            QuotationVendor[]
    plannedPurchaseOrders       PlannedPurchaseOrder[]
    plannedPurchaseOrderVendors PlannedPurchaseOrderVendor[]

    @@index([agencyId, vendorNo])
    @@index([agencyId, name])
    @@index([categoryId])
}

model VendorCategory {
    id          String   @id @default(cuid())
    name        String
    description String?
    color       String?
    agencyId    String
    agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
    vendors     Vendor[] @relation("VendorCategoryRelation")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([agencyId, name])
    @@index([agencyId])
}

model Quotation {
    id            String          @id @default(cuid())
    quotationNo   String?
    description   String?
    amount        Float?
    plannedAmount Float?          @default(0.0)
    currency      String          @default("EGP")
    status        QuotationStatus @default(REQUESTED)
    validUntil    DateTime?
    notes         String?

    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])
    taskId    String?
    task      Task?    @relation(fields: [taskId], references: [id])
    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])

    vendors        QuotationVendor[]      @relation("QuotationVendors")
    purchaseOrders PurchaseOrder[]
    plannedOrders  PlannedPurchaseOrder[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    vendor    Vendor?  @relation(fields: [vendorId], references: [id])
    vendorId  String?

    @@index([agencyId, status])
    @@index([projectId])
}

model QuotationVendor {
    id          String    @id @default(cuid())
    quotationId String
    quotation   Quotation @relation("QuotationVendors", fields: [quotationId], references: [id], onDelete: Cascade)
    vendorId    String
    vendor      Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

    @@unique([quotationId, vendorId])
}

model PlannedPurchaseOrder {
    id                   String             @id @default(cuid())
    plannedPoNo          String?
    status               PlannedOrderStatus @default(PLANNED)
    totalAmount          Float              @default(0.0)
    currency             String             @default("EGP")
    expectedDeliveryDate DateTime?
    notes                String?

    quotationId String?
    quotation   Quotation? @relation(fields: [quotationId], references: [id])

    vendorId String?
    vendor   Vendor? @relation(fields: [vendorId], references: [id])

    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])
    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])

    vendors PlannedPurchaseOrderVendor[] @relation("PlannedPOVendors")
    items   PlannedPurchaseOrderItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([quotationId])
    @@index([agencyId])
}

model PlannedPurchaseOrderVendor {
    id                     String               @id @default(cuid())
    plannedPurchaseOrderId String
    plannedPurchaseOrder   PlannedPurchaseOrder @relation("PlannedPOVendors", fields: [plannedPurchaseOrderId], references: [id], onDelete: Cascade)
    vendorId               String
    vendor                 Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

    @@unique([plannedPurchaseOrderId, vendorId])
}

model PlannedPurchaseOrderItem {
    id          String @id @default(cuid())
    description String
    quantity    Float  @default(1.0)
    unitCost    Float  @default(0.0)
    total       Float  @default(0.0)

    plannedPurchaseOrderId String
    plannedPurchaseOrder   PlannedPurchaseOrder @relation(fields: [plannedPurchaseOrderId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
}

model PurchaseOrder {
    id                   String              @id @default(cuid())
    poNo                 String?
    status               PurchaseOrderStatus @default(DRAFT)
    subtotal             Float               @default(0.0)
    taxRate              Float               @default(0.0)
    taxAmount            Float               @default(0.0)
    totalAmount          Float               @default(0.0)
    currency             String              @default("EGP")
    sentAt               DateTime?
    expectedDeliveryDate DateTime?
    deliveredAt          DateTime?
    notes                String?

    vendorId    String
    vendor      Vendor     @relation(fields: [vendorId], references: [id])
    quotationId String?
    quotation   Quotation? @relation(fields: [quotationId], references: [id])
    projectId   String?
    project     Project?   @relation(fields: [projectId], references: [id])
    agencyId    String
    agency      Agency     @relation(fields: [agencyId], references: [id])

    items PurchaseOrderItem[]

    createdAt                DateTime                  @default(now())
    updatedAt                DateTime                  @updatedAt
    vendorPerformanceReviews VendorPerformanceReview[]

    @@unique([agencyId, poNo])
    @@index([vendorId, status])
    @@index([projectId])
    @@index([quotationId])
}

model PurchaseOrderItem {
    id          String @id @default(cuid())
    description String
    quantity    Float  @default(1.0)
    unitCost    Float  @default(0.0)
    total       Float  @default(0.0)

    purchaseOrderId String
    purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

    createdAt DateTime @default(now())
}

model VendorPerformanceReview {
    id             String  @id @default(cuid())
    rating         Int
    onTimeDelivery Boolean @default(true)
    comment        String?

    vendorId  String
    vendor    Vendor   @relation(fields: [vendorId], references: [id])
    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])
    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])

    purchaseOrderId String?
    purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

    createdAt DateTime @default(now())

    @@index([vendorId])
}

model Asset {
    id                 String      @id @default(cuid())
    assetNo            String?
    assetName          String
    category           String
    purchaseDate       DateTime?
    currentValue       Float
    availabilityStatus AssetStatus @default(AVAILABLE)
    serialNumber       String?
    location           String?
    maintenanceDueAt   DateTime?

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id])
    tasks    Task[] @relation("TaskAssets")

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    @@index([agencyId, assetNo])
    @@index([agencyId, availabilityStatus])
}

model Expense {
    id           String        @id @default(cuid())
    expenseNo    String?
    resourceName String
    category     String
    amount       Float
    currency     String        @default("EGP")
    status       ExpenseStatus @default(DRAFT)
    date         DateTime
    description  String?

    agencyId String
    agency   Agency  @relation(fields: [agencyId], references: [id])
    userId   String?
    user     User?   @relation(fields: [userId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, expenseNo])
    @@index([agencyId, date])
}

// --------------------------------------
// 8. Collaboration, Files & Audit
// --------------------------------------

model Notification {
    id        String           @id @default(cuid())
    title     String
    message   String
    type      NotificationType @default(SYSTEM)
    isRead    Boolean          @default(false)
    actionUrl String?

    userId   String
    user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

    createdAt DateTime  @default(now())
    readAt    DateTime?

    @@index([userId, isRead])
    @@index([agencyId])
}

model Attachment {
    id          String  @id @default(cuid())
    fileName    String
    fileUrl     String
    mimeType    String?
    size        Int?
    description String?

    agencyId     String
    agency       Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
    uploadedById String?
    uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

    projectId String?
    project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
    taskId    String?
    task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())

    @@index([agencyId, createdAt])
    @@index([projectId])
    @@index([taskId])
}

model AuditLog {
    id         String      @id @default(cuid())
    action     AuditAction
    entityType String
    entityId   String
    message    String?
    metadata   Json?
    ipAddress  String?
    userAgent  String?

    agencyId String
    agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
    actorId  String?
    actor    User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

    timestamp DateTime @default(now())

    @@index([agencyId, entityType, entityId])
    @@index([actorId, timestamp])
}

model Webhook {
    id       String   @id @default(cuid())
    name     String
    url      String
    events   String[]
    secret   String?
    isActive Boolean  @default(true)

    agencyId String
    agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, isActive])
}

model Announcement {
    id        String               @id @default(cuid())
    title     String
    body      String
    audience  AnnouncementAudience @default(ALL_STAFF)
    publishAt DateTime             @default(now())
    expiresAt DateTime?

    agencyId String
    agency   Agency  @relation(fields: [agencyId], references: [id])
    authorId String?
    author   User?   @relation(fields: [authorId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, publishAt])
}

model ApprovalRequest {
    id         String             @id @default(cuid())
    entityType ApprovalEntityType
    entityId   String
    status     ApprovalStatus     @default(PENDING)
    notes      String?
    decidedAt  DateTime?

    agencyId    String
    agency      Agency  @relation(fields: [agencyId], references: [id])
    requesterId String?
    requester   User?   @relation("ApprovalRequester", fields: [requesterId], references: [id])
    deciderId   String?
    decider     User?   @relation("ApprovalDecider", fields: [deciderId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([agencyId, entityType, entityId])
    @@index([status])
}

model EmailLog {
    id           String      @id @default(cuid())
    toEmail      String
    subject      String
    template     String?
    status       EmailStatus @default(QUEUED)
    errorMessage String?
    sentAt       DateTime?

    agencyId String?
    agency   Agency? @relation(fields: [agencyId], references: [id])

    createdAt DateTime @default(now())

    @@index([agencyId, createdAt])
    @@index([toEmail])
}

model ClientFeedback {
    id      String  @id @default(cuid())
    rating  Int
    comment String?

    agencyId  String
    agency    Agency   @relation(fields: [agencyId], references: [id])
    clientId  String
    client    Client   @relation(fields: [clientId], references: [id])
    projectId String?
    project   Project? @relation(fields: [projectId], references: [id])

    createdAt DateTime @default(now())

    @@index([clientId])
    @@index([projectId])
}
